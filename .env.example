# ─── Obrigatório ────────────────────────────────────────────────
# URL pública do site (SEO, Open Graph, sitemap, links de e-mail)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br
# Segredo das sessões do painel (mínimo 32 caracteres). Gere com: openssl rand -hex 32
SESSION_SECRET=
# Primeiro administrador — criado automaticamente quando não há usuários
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# ─── Banco de dados ─────────────────────────────────────────────
# Supabase: Project Settings → Database → Connection string (URI, Transaction pooler 6543)
# Vazio = SQLite local em DATA_DIR (bom para desenvolvimento ou VPS com disco persistente)
DATABASE_URL=
# DATABASE_SSL=false          # para Postgres local sem SSL
# DATABASE_POOL_MAX=5
# DATA_DIR=./data

# ─── Armazenamento de arquivos (Supabase Storage) ───────────────
# Vazio = arquivos salvos em DATA_DIR/uploads e servidos em /uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media
# UPLOAD_MAX_MB=30

# ─── Notificações e CRM ─────────────────────────────────────────
# E-mail via Resend (https://resend.com) — notifica a equipe e envia o mídia kit
RESEND_API_KEY=
MAIL_FROM="O Milagre do Natal <comercial@seudominio.com.br>"
LEAD_NOTIFY_EMAIL=comercial@seudominio.com.br
# Webhook: recebe {event:"lead.created", lead:{...}} a cada envio (n8n, Make, Zapier, RD Station, HubSpot…)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# ─── Anti-spam (opcional) — Cloudflare Turnstile ────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Medição (também configuráveis no painel → SEO e rastreamento)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
