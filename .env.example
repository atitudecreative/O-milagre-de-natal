# --- Obrigatórias -------------------------------------------------------------
# URL pública do site (usada em links de e-mail, sitemap, PDF e Open Graph)
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Chave pública (anon/publishable). Pode ir ao navegador — o RLS protege os dados.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service_role). SOMENTE servidor: convites de equipe e notificações.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo aleatório (mín. 32 caracteres) para gerar o hash irreversível de IPs (antispam/LGPD)
APP_SECRET=

# --- Opcionais ----------------------------------------------------------------
# Notificação de novos leads por e-mail (https://resend.com)
RESEND_API_KEY=
LEAD_NOTIFY_FROM="Palco <leads@seu-dominio.com.br>"
# Destinatários padrão quando o evento não define e-mails próprios
LEAD_NOTIFY_TO=comercial@seu-dominio.com.br
# Webhook (CRM externo, Slack, Zapier…) chamado a cada novo lead
LEAD_WEBHOOK_URL=
# Cloudflare Turnstile (proteção extra contra bots no formulário)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
